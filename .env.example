# PostgreSQL
POSTGRES_DB=inscripciones
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend - base de datos
DATABASE_URL=jdbc:postgresql://postgres:5432/inscripciones
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Evento
EVENTO_CUPO_MAXIMO=10
EVENTO_SEDE_CONSEJO=Lima

# API mock de colegiados (red interna Docker)
COLEGIADOS_API_URL=http://colegiados-mock:3001

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=inscripciones-imagenes

# CORS (origen del frontend en Docker)
CORS_ALLOWED_ORIGINS=http://localhost

# Puertos expuestos en el host (opcional)
BACKEND_PORT=8080
FRONTEND_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
